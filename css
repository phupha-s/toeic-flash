@import url('https://fonts.googleapis.com/css2?family=Kanit:wght@400;600;800&display=swap');

:root {
    --bg-color: #0f172a;
    --text-color: #f8fafc;
    --primary: #f59e0b;
    --secondary: #3b82f6;
    --danger: #ef4444;
    --success: #10b981;
    --box-bg: #1e293b;
}

body {
    margin: 0;
    font-family: 'Kanit', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.container, .game-container {
    background: var(--box-bg);
    padding: 2rem;
    border-radius: 16px;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    text-align: center;
}

.game-container { max-width: 600px; }

h1 { color: var(--primary); margin-bottom: 0.5rem; }
input {
    width: 90%;
    padding: 12px;
    margin: 10px 0;
    border-radius: 8px;
    border: none;
    font-size: 1rem;
    font-family: 'Kanit', sans-serif;
}

button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    font-family: 'Kanit', sans-serif;
    transition: 0.2s;
    margin-top: 10px;
}

.btn-primary { background: var(--primary); color: #000; }
.btn-primary:hover { background: #d97706; }
.btn-secondary { background: var(--secondary); color: #fff; }
.btn-secondary:hover { background: #2563eb; }
.btn-audio { background: #475569; color: white; width: auto; padding: 10px 20px; }
.btn-submit { background: var(--success); color: white; margin-top: 20px;}

.hidden { display: none !important; }
.or-text { margin: 15px 0; color: #94a3b8; }

/* Game Layout & Elevator */
.game-header { display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 1rem; }
.timer-board { font-size: 2rem; font-weight: 800; color: var(--danger); margin-bottom: 1.5rem; }
.game-layout { display: flex; gap: 20px; text-align: left; }

.elevator-system { width: 80px; text-align: center; }
.elevator-track { display: flex; flex-direction: column-reverse; background: #0f172a; padding: 10px; border-radius: 8px; border: 2px solid #334155; }
.floor { padding: 10px 0; border-bottom: 1px solid #334155; font-weight: bold; color: #64748b; }
.floor:first-child { border-bottom: none; }
.active-floor { color: var(--primary); font-size: 1.2rem; }
.highest-score { margin-top: 10px; font-size: 0.8rem; color: #94a3b8; }

.question-area { flex-grow: 1; }
.question-text { font-size: 1.2rem; margin-bottom: 15px; }

.option-btn {
    background: #334155;
    color: white;
    text-align: left;
    padding: 12px 20px;
    margin: 5px 0;
}
.option-btn.selected { background: var(--secondary); border: 2px solid #fff; }
/* Leaderboard Styles */
.subtitle {
    color: #94a3b8;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.leaderboard {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
    max-height: 350px;
    overflow-y: auto;
}

.rank-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #334155;
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: bold;
}

.rank-item.highlight {
    background: var(--primary);
    color: #000;
}

.rank { width: 50px; text-align: left; }
.name { flex-grow: 1; text-align: left; }
.score { font-size: 1.2rem; color: #f59e0b; }
.rank-item.highlight .score { color: #000; }
